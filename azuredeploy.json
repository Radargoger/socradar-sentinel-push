{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "SOCRadar Alarms (Push) - creates the SOCRadar_Alarms_CL table, a Data Collection Endpoint and a Data Collection Rule in an existing Log Analytics workspace, and grants an Entra application permission to write to that rule. No Logic App or Function App is created. Generated by tools/build_schema.py."
  },
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Existing Log Analytics workspace (Sentinel-enabled) in this resource group"
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Must be the workspace region"
      }
    },
    "dceName": {
      "type": "string",
      "defaultValue": "socradar-push-dce"
    },
    "dcrName": {
      "type": "string",
      "defaultValue": "socradar-alarms-push-dcr"
    },
    "servicePrincipalObjectId": {
      "type": "string",
      "defaultValue": "",
      "metadata": {
        "description": "Object ID of the Entra application's service principal (Enterprise application > Object ID). Leave empty to assign the role yourself later."
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.OperationalInsights/workspaces/tables",
      "apiVersion": "2022-10-01",
      "name": "[concat(parameters('workspaceName'), '/SOCRadar_Alarms_CL')]",
      "properties": {
        "schema": {
          "name": "SOCRadar_Alarms_CL",
          "columns": [
            {
              "name": "TimeGenerated",
              "type": "datetime"
            },
            {
              "name": "AlarmId",
              "type": "string"
            },
            {
              "name": "CompanyId",
              "type": "string"
            },
            {
              "name": "AlarmMainType",
              "type": "string"
            },
            {
              "name": "AlarmSubType",
              "type": "string"
            },
            {
              "name": "Severity",
              "type": "string"
            },
            {
              "name": "Status",
              "type": "string"
            },
            {
              "name": "Title",
              "type": "string"
            },
            {
              "name": "AlarmText",
              "type": "string"
            },
            {
              "name": "AlarmDate",
              "type": "string"
            },
            {
              "name": "AlarmPayload",
              "type": "dynamic"
            },
            {
              "name": "EventType",
              "type": "string"
            },
            {
              "name": "CompanyName",
              "type": "string"
            },
            {
              "name": "AlarmAsset",
              "type": "string"
            },
            {
              "name": "AlarmUrl",
              "type": "string"
            },
            {
              "name": "Tags",
              "type": "dynamic"
            },
            {
              "name": "AlarmUpdatedAt",
              "type": "string"
            },
            {
              "name": "ConnectorVersion",
              "type": "string"
            }
          ]
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionEndpoints",
      "apiVersion": "2022-06-01",
      "name": "[parameters('dceName')]",
      "location": "[parameters('location')]",
      "properties": {
        "networkAcls": {
          "publicNetworkAccess": "Enabled"
        }
      }
    },
    {
      "type": "Microsoft.Insights/dataCollectionRules",
      "apiVersion": "2022-06-01",
      "name": "[parameters('dcrName')]",
      "location": "[parameters('location')]",
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces/tables', parameters('workspaceName'), 'SOCRadar_Alarms_CL')]",
        "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName'))]"
      ],
      "properties": {
        "dataCollectionEndpointId": "[resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName'))]",
        "streamDeclarations": {
          "Custom-SOCRadarAlarmsPush": {
            "columns": [
              {
                "name": "AlarmId",
                "type": "string"
              },
              {
                "name": "CompanyId",
                "type": "string"
              },
              {
                "name": "AlarmMainType",
                "type": "string"
              },
              {
                "name": "AlarmSubType",
                "type": "string"
              },
              {
                "name": "Severity",
                "type": "string"
              },
              {
                "name": "Status",
                "type": "string"
              },
              {
                "name": "Title",
                "type": "string"
              },
              {
                "name": "AlarmText",
                "type": "string"
              },
              {
                "name": "AlarmDate",
                "type": "string"
              },
              {
                "name": "AlarmPayload",
                "type": "dynamic"
              },
              {
                "name": "EventType",
                "type": "string"
              },
              {
                "name": "CompanyName",
                "type": "string"
              },
              {
                "name": "AlarmAsset",
                "type": "string"
              },
              {
                "name": "AlarmUrl",
                "type": "string"
              },
              {
                "name": "Tags",
                "type": "dynamic"
              },
              {
                "name": "AlarmUpdatedAt",
                "type": "string"
              },
              {
                "name": "ConnectorVersion",
                "type": "string"
              }
            ]
          }
        },
        "destinations": {
          "logAnalytics": [
            {
              "workspaceResourceId": "[resourceId('Microsoft.OperationalInsights/workspaces', parameters('workspaceName'))]",
              "name": "la"
            }
          ]
        },
        "dataFlows": [
          {
            "streams": [
              "Custom-SOCRadarAlarmsPush"
            ],
            "destinations": [
              "la"
            ],
            "transformKql": "source | extend TimeGenerated = iff(isnotempty(AlarmDate), todatetime(AlarmDate), now()), Severity = case(Severity == \"CRITICAL\", \"Critical\", Severity == \"HIGH\", \"High\", Severity == \"MEDIUM\", \"Medium\", Severity == \"LOW\", \"Low\", Severity == \"INFO\", \"Info\", Severity)",
            "outputStream": "Custom-SOCRadar_Alarms_CL"
          }
        ]
      }
    },
    {
      "type": "Microsoft.Authorization/roleAssignments",
      "apiVersion": "2022-04-01",
      "condition": "[not(empty(parameters('servicePrincipalObjectId')))]",
      "name": "[guid(resourceGroup().id, parameters('dcrName'), parameters('servicePrincipalObjectId'))]",
      "scope": "[format('Microsoft.Insights/dataCollectionRules/{0}', parameters('dcrName'))]",
      "dependsOn": [
        "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName'))]"
      ],
      "properties": {
        "roleDefinitionId": "[subscriptionResourceId('Microsoft.Authorization/roleDefinitions', '3913510d-42f4-4e42-8a64-420c390055eb')]",
        "principalId": "[parameters('servicePrincipalObjectId')]",
        "principalType": "ServicePrincipal"
      }
    }
  ],
  "outputs": {
    "dataCollectionEndpoint": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionEndpoints', parameters('dceName')), '2022-06-01').logsIngestion.endpoint]"
    },
    "dataCollectionRuleImmutableId": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName')), '2022-06-01').immutableId]"
    },
    "dataCollectionRuleResourceId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Insights/dataCollectionRules', parameters('dcrName'))]"
    },
    "streamName": {
      "type": "string",
      "value": "Custom-SOCRadarAlarmsPush"
    },
    "tenantId": {
      "type": "string",
      "value": "[subscription().tenantId]"
    }
  }
}
